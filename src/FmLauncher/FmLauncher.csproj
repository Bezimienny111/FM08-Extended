<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyTitle>FM08 Extended</AssemblyTitle>
    <Product>FM08 Extended</Product>
    <Description>FM08 Extended game launcher</Description>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0-preview</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="FmLauncher.languages.json" />
    <None Update="FmLauncher.languages.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="FmLauncher.Tests" />
  </ItemGroup>
</Project>
